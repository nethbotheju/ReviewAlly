{
  "name": "reviewally",
  "version": "0.1.0",
  "private": true,
  "description": "ReviewAlly — AI-powered pull request code review GitHub Action (bring-your-own-key).",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "bundle": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@ai-sdk/anthropic": "^4.0.20",
    "@ai-sdk/openai": "^4.0.20",
    "ai": "^7.0.37",
    "jsonrepair": "^3.15.0",
    "minimatch": "^9.0.5",
    "tar": "^7.5.22",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^20.11.30",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typebox": "1.3.27",
    "typescript": "^5.4.5"
  }
}
